# Copy this file to .env and replace the placeholder values.
# The .env file is ignored by git and must never be committed.

# Database credentials (used by the db service)
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_USER=change_me_user
MYSQL_PASSWORD=change_me_password

# Database credentials (used by the wordpress service)
# Must match MYSQL_USER and MYSQL_PASSWORD above.
WORDPRESS_DB_USER=change_me_user
WORDPRESS_DB_PASSWORD=change_me_password

# Optional settings, the values below are the defaults.
# DB_NAME=wordpress
# WORDPRESS_PORT=8080
# WORDPRESS_TABLE_PREFIX=wp_
